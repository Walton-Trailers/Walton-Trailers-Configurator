# Walton Trailers Configurator — environment variables
# Actual values live in the Vercel project settings (Settings → Environment
# Variables). This file documents what the app reads; it holds no secrets.

# ── Email: outgoing notifications (dealer invites, order submissions, password
#    resets, lead forwarding). Without a provider the app runs in "console"
#    mode — it logs emails instead of sending them. ─────────────────────────────
# Provider: gmail | smtp | outlook | console   (default: console)
EMAIL_PROVIDER=gmail

# Gmail / Google Workspace (EMAIL_PROVIDER=gmail)
GMAIL_USER=info@waltontrailers.com
GMAIL_APP_PASSWORD=                 # 16-char Google App Password (account needs 2-Step Verification)
EMAIL_FROM=Walton Trailers <info@waltontrailers.com>   # optional; defaults to GMAIL_USER

# SMTP alternative (EMAIL_PROVIDER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Dealer Help button → Slack incoming webhook. Without this the help message
#    is only logged server-side. ───────────────────────────────────────────────
SLACK_HELP_WEBHOOK_URL=

# Note: DATABASE_URL / NEON_*, BLOB_READ_WRITE_TOKEN, and AIRTABLE_* are
# provisioned through their respective Vercel integrations.
